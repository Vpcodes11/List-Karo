# ==============================================================================
# ListKaro - Environment Variables Configuration
# Copy this file to .env.local and populate with your production credentials
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (PostgreSQL, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# AES-256 Token Encryption Key (Must be 32 bytes or 64 hex chars)
ENCRYPTION_KEY="listkaro-super-secure-32-byte-secret-key-123456"

# Shopify OAuth App Credentials
SHOPIFY_CLIENT_ID="your_shopify_partner_client_id"
SHOPIFY_CLIENT_SECRET="your_shopify_partner_client_secret"
SHOPIFY_REDIRECT_URI="http://localhost:3000/api/auth/shopify/callback"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_verification_secret"

# LLM Providers (OpenAI or Anthropic)
OPENAI_API_KEY="sk-proj-your-openai-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Payments: Razorpay (INR)
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Payments: Stripe (USD)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Transactional Emails via Resend
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="ListKaro <notifications@listkaro.in>"
